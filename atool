IS_WINDOWS = platform.system() == "Windows"

def _secure_chmod(path, mode):
    """Set file permissions (no-op on Windows)"""
    if not IS_WINDOWS:
        os.chmod(path, mode)

ATOOL_DIR = os.path.expanduser("~/.atool")
CONF_PATH = os.path.join(ATOOL_DIR, "config.ini")
CONTEXT_PATH = os.path.join(ATOOL_DIR, "context.json")  # Default, overridden by --session


def _path_owner(path, follow_symlinks=True):
    st = os.stat(path, follow_symlinks=follow_symlinks)
    return IS_WINDOWS or st.st_uid == os.getuid()


def _private_file_error(path):
    """Return why a credential/context file is unsafe, or an empty string."""
    try:
        parent = os.path.dirname(path) or "."
        parent_st = os.stat(parent)
        if not stat.S_ISDIR(parent_st.st_mode) or not _path_owner(parent):
            return "has an unsafe parent directory"
        if not IS_WINDOWS and parent_st.st_mode & 0o022:
            return "has a group/world-writable parent directory"
        st = os.lstat(path)
        if stat.S_ISLNK(st.st_mode):
            return "is a symbolic link"
        if not stat.S_ISREG(st.st_mode):
            return "is not a regular file"
        if not _path_owner(path, follow_symlinks=False):
            return "has an unexpected owner"
        if not IS_WINDOWS and st.st_mode & 0o077:
            return "is accessible by group or other users"
    except OSError as e:
        return str(e)
    return ""


def _ensure_private_dir():
    """Create or validate ~/.atool and enforce private POSIX permissions."""
    if os.path.lexists(ATOOL_DIR):
        st = os.lstat(ATOOL_DIR)
        if stat.S_ISLNK(st.st_mode) or not stat.S_ISDIR(st.st_mode):
            raise OSError(f"Unsafe ATOOL directory: {ATOOL_DIR}")
        if not _path_owner(ATOOL_DIR, follow_symlinks=False):
            raise OSError(f"ATOOL directory has unexpected owner: {ATOOL_DIR}")
    else:
        os.makedirs(ATOOL_DIR, mode=0o700)
    _secure_chmod(ATOOL_DIR, 0o700)


def _atomic_write_private(path, content):
    """Atomically write a private UTF-8 file without following a final symlink."""
    _ensure_private_dir()
    fd, tmp_path = tempfile.mkstemp(prefix=".atool-private-", dir=ATOOL_DIR, text=True)
    try:
        _secure_chmod(tmp_path, 0o600)
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            f.write(content)
            f.flush()
            os.fsync(f.fileno())
        os.replace(tmp_path, path)
        _secure_chmod(path, 0o600)
        if not IS_WINDOWS:
            dir_fd = os.open(ATOOL_DIR, os.O_RDONLY)
            try:
                os.fsync(dir_fd)
            finally:
                os.close(dir_fd)
    except Exception:
        try:
            os.unlink(tmp_path)
        except OSError:
            pass
        raise


def _context_path(session=None):
    """Return context file path for the given session name."""
    name = "default" if session is None else session
    if name == "default":
        return CONTEXT_PATH
    if not re.fullmatch(r"[a-zA-Z0-9_-]+", name):
        raise ValueError("Session name may contain only letters, numbers, '-' and '_'")
    return os.path.join(ATOOL_DIR, f"context-{name}.json")

