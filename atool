_OPENAI_NO_STREAM_OPTIONS = set()
_OPENAI_LEGACY_MAX_TOKENS = set()
_UNSUPPORTED_FIELD_MARKERS = (
    "unknown", "unsupported", "unrecognized", "not supported", "does not support", "not permitted",
    "unexpected", "extra input",
)


def _openai_init(system, task):
    return [{"role": "system", "content": system}, {"role": "user", "content": task}]


def _openai_url(config):
    base = config["api_url"].rstrip("/")
    return base if base.endswith("/chat/completions") else base + "/chat/completions"


def _openai_request_options(config, url, stream=False):
    options = {}
    if stream and url not in _OPENAI_NO_STREAM_OPTIONS:
        options["stream_options"] = {"include_usage": True}
    max_tokens = config.get("max_tokens")
    if max_tokens not in (None, ""):
        key = "max_tokens" if url in _OPENAI_LEGACY_MAX_TOKENS else "max_completion_tokens"
        options[key] = _coerce_int(max_tokens, 8192, minimum=1)
    return options


def _unsupported_field(error_text, field):
    lowered = error_text.lower()
    return field in lowered and any(marker in lowered for marker in _UNSUPPORTED_FIELD_MARKERS)


def _openai_compat_request(url, payload, send):
    """Retry rejected optional fields once and remember endpoint capabilities."""
    payload = dict(payload)
    while True:
        try:
            return send(payload)
        except urllib.error.HTTPError as error:
            if error.code != 400:
                raise
            try:
                body = error.read(MAX_JSON_RESPONSE_SIZE + 1)
            except Exception:
                body = b""
            finally:
                error.close()
            error_text = body.decode("utf-8", errors="replace")
            changed = []
            if "stream_options" in payload and (
                    _unsupported_field(error_text, "stream_options")
                    or _unsupported_field(error_text, "include_usage")):
                payload.pop("stream_options")
                _OPENAI_NO_STREAM_OPTIONS.add(url)
                changed.append("stream_options")
            if "max_completion_tokens" in payload and _unsupported_field(error_text, "max_completion_tokens"):
                payload["max_tokens"] = payload.pop("max_completion_tokens")
                _OPENAI_LEGACY_MAX_TOKENS.add(url)
                changed.append("max_completion_tokens")
            if not changed:
                buffered = urllib.error.HTTPError(error.url, error.code, error.msg, error.headers, io.BytesIO(body))
                raise buffered from error
            print(f"\033[33mAPI rejected {', '.join(changed)}; retrying with compatible fields\033[0m")


def _openai_request(state, config):
    url = _openai_url(config)
    headers = _bearer_headers(config["api_key"])
    payload = {"model": config["model"], "messages": state, "tools": TOOLS, "stream": True}
    payload.update(_openai_request_options(config, url, stream=True))
    resp = _openai_compat_request(url, payload, lambda current: _http_post_stream(url, headers, current))
    content_parts = []
    tc_accum = {}  # index -> {id, name, arguments}
    usage = None
    finish_reason = None
    first_text = True
    try:
        for event in _iter_sse_events(resp):
            if event.get("error"):
                error = event["error"]
                message = error.get("message", str(error)) if isinstance(error, dict) else str(error)
                raise RuntimeError(f"API stream error: {message}")
            if event.get("usage"):
                usage = event["usage"]
            choices = event.get("choices", [])
            if not choices:
                continue
            choice = choices[0]
            if choice.get("finish_reason"):
                finish_reason = choice["finish_reason"]
            delta = choice.get("delta", {})
            if delta.get("content"):
                if first_text:
                    print()
                    first_text = False
                print(delta["content"], end="", flush=True)
                content_parts.append(delta["content"])
            for tc_delta in (delta.get("tool_calls") or []):
                idx = tc_delta.get("index", 0)
                if idx not in tc_accum:
                    tc_accum[idx] = {"id": tc_delta.get("id", ""), "name": "", "arguments": ""}
                if tc_delta.get("id"):
                    tc_accum[idx]["id"] = tc_delta["id"]
                fn = tc_delta.get("function", {})
                if fn.get("name"):
                    tc_accum[idx]["name"] += fn["name"]
                if fn.get("arguments"):
                    tc_accum[idx]["arguments"] += fn["arguments"]
        if not first_text:
            print()
    finally:
        resp.close()

    if finish_reason is None:
        raise RuntimeError("API stream ended without a finish reason")
    content = "".join(content_parts) or None
    clean = {"role": "assistant", "content": content}
    tool_calls_raw = []
    for idx in sorted(tc_accum):
        tc = tc_accum[idx]
        tool_calls_raw.append({"id": tc["id"], "type": "function",
                                "function": {"name": tc["name"], "arguments": tc["arguments"]}})
    if tool_calls_raw:
        clean["tool_calls"] = tool_calls_raw
    state.append(clean)

    tool_calls = []
    for tc in tool_calls_raw:
        try:
            tool_calls.append({"id": tc["id"], "name": tc["function"]["name"],
                               "args": _parse_tool_args(tc["function"]["arguments"])})
        except (KeyError, json.JSONDecodeError, TypeError) as e:
            tool_calls.append({"id": tc.get("id", "unknown"), "name": "__parse_error__",
                               "args": {}, "_error": f"Failed to parse tool call: {e}"})
    if finish_reason == "length":
        print("\033[33mWarning: model output truncated (token limit reached)\033[0m")
    return {"content": content, "tool_calls": tool_calls, "usage": usage}


def _openai_summarize(source, config):
    url = _openai_url(config)
    headers = _bearer_headers(config["api_key"])
    payload = {
        "model": config["model"],
        "messages": [
            {"role": "system", "content": CONTEXT_SUMMARY_INSTRUCTION},
            {"role": "user", "content": source},
        ],
    }
    payload.update(_openai_request_options(config, url))
    data = _openai_compat_request(url, payload, lambda current: _http_post_json(url, headers, current))
    try:
        content = data["choices"][0]["message"]["content"]
    except (KeyError, IndexError, TypeError) as e:
        raise RuntimeError("Summary response has no message content") from e
    text = _message_text(content).strip()
    if not text:
        raise RuntimeError("Summary response is empty")
    return {"text": text, "usage": data.get("usage")}


def _openai_add_tool_result(state, call_id, result):
    if isinstance(result, dict) and result.get("_image"):
        content = json.dumps({"image_loaded": True, "note": "Image follows in the next user message"})
    else:
        content = result
    state.append({"role": "tool", "tool_call_id": call_id, "content": content})


def _openai_add_images(state, images):
    content = [{"type": "text", "text": "Image(s) returned by the read_image tool:"}]
    for image in images:
        content.append({
            "type": "image_url",
            "image_url": {"url": f"data:{image['media_type']};base64,{image['data']}"},
        })
    state.append({"role": "user", "content": content})


