def _session_arg(value):
    try:
        _context_path(value)
    except ValueError as e:
        raise argparse.ArgumentTypeError(str(e)) from e
    return value


def _read_interactive_task():
    """Read one task while keeping the usual single-line prompt fast."""
    first_line = input("\033[36m> \033[0m")
    task = first_line.strip()
    if task.lower() in ("quit", "exit", "q"):
        return None, True
    if task.lower() != "/multi":
        return task, False

    eof_hint = "Ctrl+Z then Enter" if IS_WINDOWS else "Ctrl+D"
    print(f"\033[36mMultiline mode (/send to submit, /cancel to discard, {eof_hint} to submit)\033[0m")
    lines = []
    while True:
        try:
            line = input("\033[36m... \033[0m")
        except EOFError:
            print()
            return "\n".join(lines), False
        except KeyboardInterrupt:
            print("\n\033[33mMultiline input cancelled\033[0m")
            return None, False

        command = line.lower()
        if command == "/send":
            return "\n".join(lines), False
        if command == "/cancel":
            print("\033[33mMultiline input cancelled\033[0m")
            return None, False
        lines.append(line)


def main():
    parser = argparse.ArgumentParser(description="AI ops tool")
    parser.add_argument("task", nargs="*", help="Task description for the ops operation")
    parser.add_argument("-V", "--version", action="version", version=f"atool {VERSION}")
    parser.add_argument("-y", "--yes", action="store_true", help="Skip medium confirmations; high-sensitivity actions still ask")
    parser.add_argument("--force", action="store_true", help="Skip all confirmations except locally forced dangerous patterns (use with caution)")
    parser.add_argument("-n", "--dry-run", action="store_true", help="Display tool calls without executing them")
    parser.add_argument("-c", "--continue", dest="continue_ctx", action="store_true", help="Continue previous conversation")
    parser.add_argument("-s", "--session", metavar="NAME", type=_session_arg, help="Session name for context isolation")
    parser.add_argument("-p", "--provider", choices=["openai", "claude", "codex"], help="API provider")
    parser.add_argument("--api-url", help="API URL")
    parser.add_argument("--api-key", help="API Key (prefer env var or config file, CLI args are visible in process list)")
    parser.add_argument("--model", help="Model name")
    parser.add_argument("--proxy", help="HTTP(S) proxy address")
    parser.add_argument("--language", choices=list(LANGUAGE_MAP.keys()), help="Response language (en, zh, ja)")
    parser.add_argument("-i", "--interactive", action="store_true", help="Interactive mode (/multi for multiline input)")
    args = parser.parse_args()

    config = load_config(args)
    if not config["api_key"]:
        if not sys.stdin.isatty():
            print("\033[31mError: no API credential configured; run interactively to set one up\033[0m")
            return 1
        provider_locked = bool(args.provider or os.environ.get("ATOOL_PROVIDER"))
        setup_wizard(config, provider_locked=provider_locked)
        config = load_config(args)
    if not config["api_key"]:
        print("\033[31mError: no API credential is available for the selected provider\033[0m")
        return 1
    if args.language:
        config["language"] = args.language

    interactive = args.interactive or config.get("interactive") in ("true", "1", "yes")
    try:
        _init_proxy(config.get("proxy"))
    except ValueError as e:
        print(f"\033[31mError: {e}\033[0m")
        return 2
    task = " ".join(args.task) if args.task else ""

    force = args.force
    dry_run = args.dry_run
    session = args.session

    if interactive:
        continue_ctx = args.continue_ctx
        had_failure = False
        # Run initial task from CLI args if provided
        if task:
            succeeded = main_loop(task, config, args.yes, continue_ctx, force, dry_run, session)
            had_failure = had_failure or not succeeded
            continue_ctx = succeeded
        # Interactive input loop
        print("\033[36mInteractive mode (type 'quit' to exit, '/multi' for multiline input)\033[0m")
        while True:
            try:
                task, should_exit = _read_interactive_task()
            except (KeyboardInterrupt, EOFError):
                print()
                break
            if should_exit:
                break
            if task is None or not task.strip():
                continue
            succeeded = main_loop(task, config, args.yes, continue_ctx, force, dry_run, session)
            had_failure = had_failure or not succeeded
            continue_ctx = succeeded
        return 1 if had_failure else 0
    else:
        if not task:
            if sys.stdin.isatty():
                task = input("Enter task: ").strip()
            else:
                print("\033[31mError: please specify task via arguments in non-interactive mode\033[0m")
                return 1
        if not task:
            print("\033[31mError: task cannot be empty\033[0m")
            return 1
        return 0 if main_loop(task, config, args.yes, args.continue_ctx, force, dry_run, session) else 1


if __name__ == "__main__":
    if IS_WINDOWS:
        os.system("")  # Enable Windows 10+ ANSI support
    try:
        sys.exit(main())
    except (KeyboardInterrupt, EOFError):
        print()
        sys.exit(130)
