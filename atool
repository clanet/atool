MAX_LINES = 20
MAX_CHARS = 8000
MAX_ITERATIONS = 50
MAX_CONTEXT_CHARS = 200000  # Context char limit, roughly ~60K tokens
MAX_CONTEXT_FILE_SIZE = 2 * 1024 * 1024
COMPACT_TOOL_RESULT_MIN_CHARS = 1200
COMPACT_TOOL_EXCERPT_CHARS = 600
CONTEXT_SUMMARY_MAX_CHARS = 6000
CONTEXT_SUMMARY_SOURCE_CHARS = 80000
CONTEXT_SUMMARY_MESSAGE_CHARS = 6000
MAX_TEXT_FILE_SIZE = 5 * 1024 * 1024
MAX_READ_LINES = 1000
PATCH_PREVIEW_MAX_LINES = 30
PATCH_PREVIEW_MAX_CHARS = 2500
SEARCH_TEXT_MAX_MATCHES = 100
SEARCH_MAX_FILES = 1000
SEARCH_MAX_LINE_CHARS = 2000
SEARCH_SKIP_DIRS = {".git", "node_modules", "__pycache__", ".hg", ".svn", ".tox", "venv", ".venv"}
LIST_DIR_MAX_ENTRIES = 200
DEFAULT_COMMAND_TIMEOUT = 300


def _as_bool(value, default=False):
    if isinstance(value, bool):
        return value
    if isinstance(value, str):
        val = value.strip().lower()
        if val in ("true", "1", "yes", "y", "on"):
            return True
        if val in ("false", "0", "no", "n", "off", ""):
            return False
    return default


def _truncate(text):
    """Truncate long text: keep first 20 + last 20 lines, cap total chars"""
    # Line truncation first
    lines = text.splitlines()
    if len(lines) > MAX_LINES * 2:
        head = "\n".join(lines[:MAX_LINES])
        tail = "\n".join(lines[-MAX_LINES:])
        text = f"{head}\n\n... (omitted {len(lines) - MAX_LINES * 2} middle lines, {len(lines)} total) ...\n\n{tail}"
    # Char truncation (fallback)
    if len(text) > MAX_CHARS:
        total = len(text)
        marker = f"\n\n... (omitted middle section, {total} chars total) ...\n\n"
        half = (MAX_CHARS - len(marker)) // 2
        text = f"{text[:half]}{marker}{text[-half:]}"
    return text


def _middle_excerpt(text, limit):
    if len(text) <= limit:
        return text
    marker = f"\n... (middle omitted, {len(text)} total chars) ...\n"
    if limit <= len(marker):
        return text[:limit]
    head = (limit - len(marker)) // 2
    tail = limit - len(marker) - head
    return text[:head] + marker + text[-tail:]


def _truncate_preview(text):
    """Keep preview blocks short enough for confirmation prompts."""
    lines = text.splitlines()
    if len(lines) > PATCH_PREVIEW_MAX_LINES:
        shown = "\n".join(lines[:PATCH_PREVIEW_MAX_LINES])
        text = f"{shown}\n... (preview truncated, {len(lines)} lines total)"
    if len(text) > PATCH_PREVIEW_MAX_CHARS:
        text = text[:PATCH_PREVIEW_MAX_CHARS] + "\n... (preview truncated)"
    return text


def _indent_block(text, prefix="    "):
    return "\n".join(prefix + line for line in text.splitlines())


def _read_text_file(path, errors="surrogateescape"):
    """Read a bounded regular text file."""
    flags = os.O_RDONLY | getattr(os, "O_NONBLOCK", 0) | getattr(os, "O_NOFOLLOW", 0)
    fd = os.open(path, flags)
    with os.fdopen(fd, "rb") as f:
        st = os.fstat(f.fileno())
        if not stat.S_ISREG(st.st_mode):
            raise OSError("Path is not a regular file")
        if st.st_size > MAX_TEXT_FILE_SIZE:
            raise OSError(f"Text file is too large (>{MAX_TEXT_FILE_SIZE // (1024 * 1024)}MiB)")
        data = f.read(MAX_TEXT_FILE_SIZE + 1)
    if len(data) > MAX_TEXT_FILE_SIZE:
        raise OSError(f"Text file is too large (>{MAX_TEXT_FILE_SIZE // (1024 * 1024)}MiB)")
    if b"\0" in data:
        raise OSError("Path appears to be a binary file")
    return data.decode("utf-8", errors=errors)


def _coerce_int(value, default, minimum=None, maximum=None):
    if value is None or value == "":
        return default
    try:
        num = int(value)
    except (ValueError, TypeError):
        return default
    if minimum is not None and num < minimum:
        num = minimum
    if maximum is not None and num > maximum:
        num = maximum
    return num


def _sanitize_str(text):
    """Replace surrogate escapes with the replacement character for safe JSON encoding"""
    return text.encode("utf-8", errors="replace").decode("utf-8")


def _sanitize_result_value(value):
    """Copy a JSON result while bounding and sanitizing every nested string."""
    if isinstance(value, str):
        return _truncate(_sanitize_str(value))
    if isinstance(value, (list, tuple)):
        return [_sanitize_result_value(item) for item in value]
    if isinstance(value, dict):
        return {
            _sanitize_str(key if isinstance(key, str) else str(key)): _sanitize_result_value(item)
            for key, item in value.items()
        }
    return value


def _json_size(value):
    return len(json.dumps(value, ensure_ascii=False))


def _fit_result_lists(result):
    """Trim top-level result arrays to the largest prefix that fits."""
    for key in [name for name, value in result.items() if isinstance(value, list)]:
        if _json_size(result) <= MAX_CHARS:
            break
        items = result[key]
        result["result_truncated"] = True
        result["truncated"] = True
        omitted_key = f"omitted_{key}"
        result[omitted_key] = len(items)
        if key == "matches":
            result["available_count"] = result.get("count", len(items))
            result["count"] = 0
        elif key == "entries":
            result["returned_count"] = 0

        low, high, best = 0, len(items), 0
        while low <= high:
            count = (low + high) // 2
            result[key] = items[:count]
            result[omitted_key] = len(items) - count
            if key == "matches":
                result["count"] = count
            elif key == "entries":
                result["returned_count"] = count
            if _json_size(result) <= MAX_CHARS:
                best = count
                low = count + 1
            else:
                high = count - 1

        result[key] = items[:best]
        result[omitted_key] = len(items) - best
        if key == "matches":
            result["count"] = best
        elif key == "entries":
            result["returned_count"] = best


def _fit_result_strings(result):
    """Use remaining budget for the largest top-level text fields."""
    while _json_size(result) > MAX_CHARS:
        candidates = [(len(value), key) for key, value in result.items() if isinstance(value, str) and value]
        if not candidates:
            return
        _, key = max(candidates)
        original = result[key]
        result["result_truncated"] = True
        result[key] = ""
        if _json_size(result) > MAX_CHARS:
            continue

        low, high, best = 0, len(original), ""
        while low <= high:
            limit = (low + high) // 2
            candidate = _middle_excerpt(original, limit)
            result[key] = candidate
            if _json_size(result) <= MAX_CHARS:
                best = candidate
                low = limit + 1
            else:
                high = limit - 1
        result[key] = best


def _result_envelope(result):
    """Last-resort bounded representation for an unusual oversized result shape."""
    serialized = json.dumps(result, ensure_ascii=False)
    envelope = {"result_truncated": True, "result_excerpt": ""}
    low, high, best = 0, len(serialized), ""
    while low <= high:
        limit = (low + high) // 2
        candidate = _middle_excerpt(serialized, limit)
        envelope["result_excerpt"] = candidate
        if _json_size(envelope) <= MAX_CHARS:
            best = candidate
            low = limit + 1
        else:
            high = limit - 1
    envelope["result_excerpt"] = best
    return envelope


_STRIP_FROM_RESULT = {
    "write_file": {"backup_path"},
    "patch_file": {"backup_path"},
    "search_text": {"files_scanned"},
}


def _truncate_result(result, tool_name=None):
    """Return a sanitized tool result whose complete JSON fits the outbound budget."""
    strip_keys = _STRIP_FROM_RESULT.get(tool_name, set())
    bounded = {
        key: _sanitize_result_value(value)
        for key, value in result.items()
        if key not in strip_keys
    }
    _fit_result_lists(bounded)
    _fit_result_strings(bounded)
    return bounded if _json_size(bounded) <= MAX_CHARS else _result_envelope(bounded)


def _read_stream(stream, parts, max_chars):
    """Drain a process stream while retaining bounded head and tail excerpts."""
    head_limit = max_chars // 2
    tail_limit = max_chars - head_limit
    retained = ""
    head = ""
    tail = ""
    total = 0
    truncated = False
    while True:
        chunk = stream.read(4096)
        if not chunk:
            if truncated:
                omitted = max(0, total - len(head) - len(tail))
                marker = (
                    f"\n... (output exceeded {max_chars} chars; "
                    f"omitted {omitted} middle chars, {total} total) ...\n"
                )
                parts.append(head + marker + tail)
            else:
                parts.append(retained)
            return truncated
        total += len(chunk)
        if not truncated:
            retained += chunk
            if len(retained) > max_chars:
                truncated = True
                head = retained[:head_limit]
                tail = retained[-tail_limit:] if tail_limit else ""
                retained = ""
        elif tail_limit:
            tail = (tail + chunk)[-tail_limit:]


def _kill_proc(proc):
    """Kill process and its children"""
    try:
        if IS_WINDOWS:
            subprocess.call(["taskkill", "/F", "/T", "/PID", str(proc.pid)],
                            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        else:
            os.killpg(proc.pid, signal.SIGKILL)
    except OSError:
        pass


def execute_command(command, cwd=None, timeout_sec=None, shell=None):
    proc = None
    stdout_parts, stderr_parts = [], []
    try:
        if not isinstance(command, str) or not command.strip():
            return {"stdout": "", "stderr": "Command must be a non-empty string", "returncode": -1}
        workdir = _safe_realpath(cwd) if cwd else None
        if workdir and not os.path.isdir(workdir):
            return {"stdout": "", "stderr": f"Working directory does not exist: {workdir}", "returncode": -1}
        use_shell = _as_bool(shell, False)
        timeout = _coerce_int(timeout_sec, DEFAULT_COMMAND_TIMEOUT, minimum=1, maximum=3600)

        popen_shell = use_shell
        if IS_WINDOWS:
            if use_shell:
                # Run via PowerShell directly to avoid cmd.exe mangling pipes and quotes
                popen_args = ["powershell", "-NoProfile", "-NonInteractive", "-Command", command]
                popen_shell = False
            else:
                popen_args = shlex.split(command, posix=False)
        else:
            popen_args = command if use_shell else shlex.split(command)

        proc = subprocess.Popen(
            popen_args,
            shell=popen_shell,
            cwd=workdir,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            encoding="utf-8",
            errors="replace",
            start_new_session=not IS_WINDOWS,
        )
        thread_errors = []

        # Drain stdout/stderr in parallel so output limits never block the child.
        def read_out():
            try:
                _read_stream(proc.stdout, stdout_parts, MAX_CHARS)
            except Exception as e:
                thread_errors.append(f"stdout read error: {e}")
        def read_err():
            try:
                _read_stream(proc.stderr, stderr_parts, MAX_CHARS)
            except Exception as e:
                thread_errors.append(f"stderr read error: {e}")

        t1 = threading.Thread(target=read_out, daemon=True)
        t2 = threading.Thread(target=read_err, daemon=True)
        t1.start()
        t2.start()
        timed_out = False
        try:
            proc.wait(timeout=timeout)
        except subprocess.TimeoutExpired:
            _kill_proc(proc)
            proc.wait()
            timed_out = True
        t1.join(timeout=2)
        t2.join(timeout=2)

        stdout = "".join(stdout_parts)
        stderr = "".join(stderr_parts)
        if thread_errors:
            details = "; ".join(thread_errors)
            stderr = details if not stderr else stderr + "\n" + details
            return {"stdout": stdout, "stderr": stderr, "returncode": -1}
        if timed_out:
            stderr = f"Command timed out ({timeout}s)" if not stderr else stderr + f"\nCommand timed out ({timeout}s)"
            return {"stdout": stdout, "stderr": stderr, "returncode": -1}
        return {"stdout": stdout, "stderr": stderr, "returncode": proc.returncode}
    except KeyboardInterrupt:
        if proc is not None:
            _kill_proc(proc)
            proc.wait()
        return {"stdout": "".join(stdout_parts), "stderr": "Interrupted by user (Ctrl+C)", "returncode": -1}
    except Exception as e:
        return {"stdout": "", "stderr": str(e), "returncode": -1}
    finally:
        if proc is not None:
            for stream in (proc.stdout, proc.stderr):
                try:
                    if stream:
                        stream.close()
                except Exception:
                    pass


def _protected_read_path(path):
    exact = {
        _safe_realpath(CONF_PATH),
        _safe_realpath(os.path.expanduser("~/.codex/auth.json")),
        _safe_realpath(os.path.expanduser("~/.claude/.credentials.json")),
        _safe_realpath(os.path.expanduser("~/.aws/credentials")),
    }
    if path in exact:
        return True
    atool_dir = _safe_realpath(ATOOL_DIR)
    if os.path.dirname(path) == atool_dir:
        name = os.path.basename(path)
        if name.startswith("config.ini") or (name.startswith("context") and name.endswith(".json")):
            return True
    protected_dirs = (
        _safe_realpath(os.path.expanduser("~/.ssh")),
        _safe_realpath(os.path.expanduser("~/.gnupg")),
    )
    return any(path == root or path.startswith(root + os.sep) for root in protected_dirs)


def stat_path(path):
    try:
        expanded = os.path.abspath(os.path.expanduser(path))
        st = os.lstat(expanded)
        mode = st.st_mode
        if stat.S_ISLNK(mode):
            kind = "symlink"
        elif stat.S_ISREG(mode):
            kind = "file"
        elif stat.S_ISDIR(mode):
            kind = "directory"
        elif stat.S_ISFIFO(mode):
            kind = "fifo"
        elif stat.S_ISSOCK(mode):
            kind = "socket"
        elif stat.S_ISCHR(mode) or stat.S_ISBLK(mode):
            kind = "device"
        else:
            kind = "other"
        result = {
            "path": expanded,
            "type": kind,
            "size": st.st_size,
            "mode": oct(stat.S_IMODE(mode)),
            "mtime": st.st_mtime,
        }
        if kind == "symlink":
            result["target"] = os.readlink(expanded)
        return result
    except Exception as e:
        return {"error": str(e)}


def read_file(path, start_line=None, max_lines=None):
    try:
        path = _safe_realpath(path)
        if _protected_read_path(path):
            return {"error": "Security restriction: refusing to read a credential path"}
        start = _coerce_int(start_line, 1, minimum=1)
        limit = _coerce_int(max_lines, 200, minimum=1, maximum=MAX_READ_LINES)
        lines = _read_text_file(path, errors="replace").splitlines(keepends=True)
        total_lines = len(lines)
        captured = lines[start - 1:start - 1 + limit]

        display_start = start if total_lines >= start else (total_lines + 1 if total_lines else 1)
        end_line = display_start + len(captured) - 1 if captured else display_start - 1
        return {
            "content": "".join(captured),
            "start_line": display_start,
            "end_line": end_line,
            "total_lines": total_lines,
            "truncated": total_lines > end_line,
        }
    except Exception as e:
        return {"error": str(e)}


def list_dir(path, max_entries=None, show_hidden=False):
    try:
        path = _safe_realpath(path)
        if not os.path.isdir(path):
            return {"error": "Path is not a directory"}
        limit = _coerce_int(max_entries, 50, minimum=1, maximum=LIST_DIR_MAX_ENTRIES)
        include_hidden = _as_bool(show_hidden, False)

        entries = []
        scan_limit = limit * 10  # Cap scanning to avoid memory issues on huge directories
        scanned = 0
        with os.scandir(path) as it:
            for entry in it:
                if not include_hidden and entry.name.startswith("."):
                    continue
                scanned += 1
                if scanned > scan_limit:
                    break
                try:
                    stat = entry.stat(follow_symlinks=False)
                except OSError:
                    stat = None
                if entry.is_symlink():
                    kind = "symlink"
                elif entry.is_dir(follow_symlinks=False):
                    kind = "dir"
                elif entry.is_file(follow_symlinks=False):
                    kind = "file"
                else:
                    kind = "other"
                entries.append({
                    "name": entry.name,
                    "path": entry.path,
                    "type": kind,
                    "size": stat.st_size if stat else None,
                })

        scan_truncated = scanned > scan_limit
        entries.sort(key=lambda item: (item["type"] != "dir", item["name"].lower(), item["name"]))
        return {
            "path": path,
            "entries": entries[:limit],
            "count": len(entries),
            "truncated": len(entries) > limit or scan_truncated,
        }
    except Exception as e:
        return {"error": str(e)}


def _is_binary_file(path):
    try:
        flags = os.O_RDONLY | getattr(os, "O_NONBLOCK", 0) | getattr(os, "O_NOFOLLOW", 0)
        fd = os.open(path, flags)
        with os.fdopen(fd, "rb") as f:
            st = os.fstat(f.fileno())
            if not stat.S_ISREG(st.st_mode) or st.st_size > MAX_TEXT_FILE_SIZE:
                return True
            return b"\0" in f.read(4096)
    except Exception:
        return True


def search_text(path, query, max_matches=None, case_sensitive=False, regex=False):
    try:
        path = _safe_realpath(path)
        if _protected_read_path(path):
            return {"error": "Security restriction: refusing to search a credential path"}
        if not os.path.exists(path):
            return {"error": "Path does not exist"}
        if not isinstance(query, str) or not query:
            return {"error": "query must be a non-empty string"}
        if len(query) > 1000:
            return {"error": "query is too long (>1000 characters)"}

        limit = _coerce_int(max_matches, 20, minimum=1, maximum=SEARCH_TEXT_MAX_MATCHES)
        sensitive = _as_bool(case_sensitive, False)
        use_regex = _as_bool(regex, False)
        if use_regex:
            return {"error": "Regex search is disabled to avoid unbounded regular-expression execution"}
        needle = query if sensitive else query.lower()
        matches = []
        files_scanned = 0
        file_limit_reached = False

        def iter_targets():
            if os.path.isdir(path):
                for root, dirs, files in os.walk(path):
                    dirs[:] = [d for d in dirs if d not in SEARCH_SKIP_DIRS]
                    dirs.sort(key=lambda name: name.lower())
                    for name in sorted(files, key=lambda item: item.lower()):
                        file_path = os.path.join(root, name)
                        if os.path.islink(file_path):
                            continue
                        real_file_path = _safe_realpath(file_path)
                        if _protected_read_path(real_file_path):
                            continue
                        yield real_file_path
            else:
                yield path

        for target in iter_targets():
            if len(matches) > limit:
                break
            if files_scanned >= SEARCH_MAX_FILES:
                file_limit_reached = True
                break
            files_scanned += 1
            if _is_binary_file(target):
                continue
            try:
                content = _read_text_file(target, errors="replace")
            except (OSError, UnicodeError):
                continue
            for line_no, line in enumerate(content.splitlines(), start=1):
                text = line.rstrip("\r\n")
                haystack = text if sensitive else text.lower()
                if needle in haystack:
                    shown = text[:SEARCH_MAX_LINE_CHARS]
                    if len(text) > SEARCH_MAX_LINE_CHARS:
                        shown += "... (line truncated)"
                    matches.append({"path": target, "line": line_no, "text": shown})
                    if len(matches) > limit:
                        break

        return {
            "matches": matches[:limit],
            "count": min(len(matches), limit),
            "limit": limit,
            "files_scanned": files_scanned,
            "truncated": len(matches) > limit or file_limit_reached,
        }
    except Exception as e:
        return {"error": str(e)}


_IMAGE_EXTENSIONS = {".png": "image/png", ".jpg": "image/jpeg", ".jpeg": "image/jpeg",
                     ".gif": "image/gif", ".webp": "image/webp", ".bmp": "image/bmp"}
MAX_IMAGE_SIZE = 5 * 1024 * 1024


def read_image(path):
    try:
        path = _safe_realpath(path)
        if _protected_read_path(path):
            return {"error": "Security restriction: refusing to read a credential path"}
        ext = os.path.splitext(path)[1].lower()
        media_type = _IMAGE_EXTENSIONS.get(ext)
        if not media_type:
            return {"error": f"Unsupported image format: {ext}"}
        flags = os.O_RDONLY | getattr(os, "O_NONBLOCK", 0) | getattr(os, "O_NOFOLLOW", 0)
        fd = os.open(path, flags)
        with os.fdopen(fd, "rb") as f:
            st = os.fstat(f.fileno())
            if not stat.S_ISREG(st.st_mode):
                return {"error": "Path is not a regular file"}
            if st.st_size > MAX_IMAGE_SIZE:
                return {"error": "Image too large (>5MiB)"}
            raw = f.read(MAX_IMAGE_SIZE + 1)
        if len(raw) > MAX_IMAGE_SIZE:
            return {"error": "Image too large (>5MiB)"}
        data = base64.b64encode(raw).decode("ascii")
        return {"_image": True, "media_type": media_type, "data": data}
    except Exception as e:
        return {"error": str(e)}


def _safe_realpath(path):
    if path is None:
        return ""
    try:
        return os.path.realpath(os.path.expanduser(path))
    except Exception:
        return str(path)


MAX_BACKUPS = 5


def _make_backup(path):
    timestamp = time.strftime("%Y%m%d-%H%M%S")
    backup_path = f"{path}.atool.bak.{timestamp}-{os.getpid()}-{time.time_ns() % 1000000:06d}"
    shutil.copy2(path, backup_path)
    # Clean up old backups, keep only the most recent MAX_BACKUPS
    try:
        parent = os.path.dirname(path) or "."
        base = os.path.basename(path) + ".atool.bak."
        backup_names = [f for f in os.listdir(parent) if f.startswith(base)]
        if len(backup_names) > MAX_BACKUPS:
            backup_names.sort(reverse=True)
            for old_name in backup_names[MAX_BACKUPS:]:
                os.unlink(os.path.join(parent, old_name))
    except OSError:
        pass
    return backup_path


def _preserve_file_metadata(src_path, dst_path, src_stat=None):
    st = src_stat or os.stat(src_path, follow_symlinks=False)
    dst_stat = os.stat(dst_path, follow_symlinks=False)
    if not IS_WINDOWS and (dst_stat.st_uid, dst_stat.st_gid) != (st.st_uid, st.st_gid):
        os.chown(dst_path, st.st_uid, st.st_gid, follow_symlinks=False)
    shutil.copystat(src_path, dst_path, follow_symlinks=False)


def _same_file_version(left, right):
    return (
        left.st_dev,
        left.st_ino,
        left.st_size,
        left.st_mtime_ns,
        left.st_ctime_ns,
        left.st_nlink,
    ) == (
        right.st_dev,
        right.st_ino,
        right.st_size,
        right.st_mtime_ns,
        right.st_ctime_ns,
        right.st_nlink,
    )


def _atomic_write_text(path, content, expected_stat=None, expect_missing=False):
    directory = os.path.dirname(path) or "."
    os.makedirs(directory, exist_ok=True, mode=0o755)
    fd, tmp_path = tempfile.mkstemp(prefix=".atool-tmp-", dir=directory, text=True)
    try:
        with os.fdopen(fd, "w", encoding="utf-8", errors="surrogateescape") as f:
            f.write(content)
            f.flush()
            os.fsync(f.fileno())
        if expected_stat is not None:
            _preserve_file_metadata(path, tmp_path, expected_stat)
            current = os.stat(path, follow_symlinks=False)
            if not _same_file_version(expected_stat, current):
                raise OSError("File changed while it was being edited; refusing to overwrite it")
        elif expect_missing and os.path.lexists(path):
            raise OSError("File appeared while it was being created; refusing to overwrite it")
        os.replace(tmp_path, path)
        if not IS_WINDOWS:
            dir_fd = os.open(directory, os.O_RDONLY)
            try:
                os.fsync(dir_fd)
            finally:
                os.close(dir_fd)
    except Exception:
        try:
            os.unlink(tmp_path)
        except OSError:
            pass
        raise


def _apply_patch_edits(content, edits):
    updated = content
    applied = 0
    for idx, edit in enumerate(edits, start=1):
        if not isinstance(edit, dict):
            return {"error": f"Edit {idx}: expected an object"}
        action = str(edit.get("action", "")).strip().lower()
        target_text = edit.get("target_text")
        new_text = edit.get("new_text")
        all_matches = _as_bool(edit.get("all_matches", edit.get("replace_all")), False)

        if action not in ("replace", "insert_before", "insert_after"):
            return {"error": f"Edit {idx}: action must be replace, insert_before, or insert_after"}
        if not isinstance(target_text, str) or not isinstance(new_text, str):
            return {"error": f"Edit {idx}: target_text and new_text must be strings"}
        if not target_text:
            return {"error": f"Edit {idx}: target_text must not be empty"}

        matches = updated.count(target_text)
        if matches == 0:
            return {"error": f"Edit {idx}: target text not found"}
        if all_matches:
            count = matches
        else:
            if matches != 1:
                return {"error": f"Edit {idx}: target text matched {matches} times; provide a more specific snippet or set all_matches=true"}
            count = 1

        if action == "replace":
            updated = updated.replace(target_text, new_text, count)
        elif action == "insert_before":
            updated = updated.replace(target_text, new_text + target_text, count)
        else:
            updated = updated.replace(target_text, target_text + new_text, count)
        applied += count

    return {"content": updated, "applied": applied}


def _patch_preview(path, edits):
    try:
        path = _safe_realpath(path)
        original = _read_text_file(path)
    except Exception as e:
        return {"error": str(e)}

    applied = _apply_patch_edits(original, edits)
    if "error" in applied:
        return applied

    updated = applied["content"]
    if updated == original:
        return {"preview": "No content changes"}

    diff_lines = list(difflib.unified_diff(
        original.splitlines(),
        updated.splitlines(),
        fromfile=path,
        tofile=path,
        lineterm="",
        n=2,
    ))
    if not diff_lines:
        return {"preview": "No content changes"}
    preview = _sanitize_str("\n".join(diff_lines))
    return {"preview": _truncate_preview(preview), "applied": applied["applied"]}


def write_file(path, content, expected_exists=None, confirmed_stat=None):
    try:
        path = _safe_realpath(path)
        if path == _safe_realpath(CONF_PATH):
            return {"error": "Security restriction: cannot overwrite config file through model tools"}
        if not isinstance(content, str):
            return {"error": "content must be a string"}
        if len(content.encode("utf-8", errors="surrogateescape")) > MAX_TEXT_FILE_SIZE:
            return {"error": f"Content is too large (>{MAX_TEXT_FILE_SIZE // (1024 * 1024)}MiB)"}
        existed = os.path.exists(path)
        if expected_exists is not None and existed != expected_exists:
            return {"error": "Path existence changed after confirmation; refusing to write"}
        original_stat = os.stat(path, follow_symlinks=False) if existed else None
        if original_stat is not None:
            if confirmed_stat is not None and not _same_file_version(confirmed_stat, original_stat):
                return {"error": "File changed after confirmation; refusing to write"}
            if not stat.S_ISREG(original_stat.st_mode):
                return {"error": "Path is not a regular file"}
            if original_stat.st_nlink > 1:
                return {"error": "Refusing to replace a file with multiple hard links"}
        previous = _read_text_file(path) if existed else None
        changed = (not existed) or previous != content
        backup_path = ""
        if changed and existed:
            backup_path = _make_backup(path)
        if changed:
            _atomic_write_text(path, content, expected_stat=original_stat, expect_missing=not existed)
        return {"success": True, "changed": changed, "created": not existed, "backup_path": backup_path}
    except Exception as e:
        return {"error": str(e)}


def patch_file(path, edits, confirmed_stat=None):
    try:
        path = _safe_realpath(path)
        if path == _safe_realpath(CONF_PATH):
            return {"error": "Security restriction: cannot modify config file through model tools"}
        if not os.path.exists(path):
            return {"error": "File does not exist; use write_file to create a new file"}
        original_stat = os.stat(path, follow_symlinks=False)
        if confirmed_stat is not None and not _same_file_version(confirmed_stat, original_stat):
            return {"error": "File changed after confirmation; refusing to patch"}
        if not stat.S_ISREG(original_stat.st_mode):
            return {"error": "Path is not a regular file"}
        if original_stat.st_nlink > 1:
            return {"error": "Refusing to replace a file with multiple hard links"}
        content = _read_text_file(path)

        applied = _apply_patch_edits(content, edits)
        if "error" in applied:
            return applied
        updated = applied["content"]

        changed = updated != content
        backup_path = ""
        if changed:
            backup_path = _make_backup(path)
            _atomic_write_text(path, updated, expected_stat=original_stat)
        return {"success": True, "changed": changed, "edits": len(edits), "applied": applied["applied"], "backup_path": backup_path}
    except Exception as e:
        return {"error": str(e)}


TOOL_HANDLERS = {
    "execute_command": lambda a: execute_command(a["command"], a.get("cwd"), a.get("timeout_sec"), a.get("shell")),
    "stat_path": lambda a: stat_path(a["path"]),
    "list_dir": lambda a: list_dir(a["path"], a.get("max_entries"), a.get("show_hidden", False)),
    "read_file": lambda a: read_file(a["path"], a.get("start_line"), a.get("max_lines")),
    "search_text": lambda a: search_text(a["path"], a["query"], a.get("max_matches"), a.get("case_sensitive", False), a.get("regex", False)),
    "patch_file": lambda a: patch_file(a["path"], a["edits"]),
    "write_file": lambda a: write_file(a["path"], a["content"]),
    "read_image": lambda a: read_image(a["path"]),
}


# ============================================================
# Confirmation logic
# ============================================================

# Local safeguard: force confirmation for obviously dangerous patterns
DANGEROUS_REGEXES = [re.compile(p) for p in [
    r'\brm\b', r'\brmdir\b', r'\bunlink\b', r'\bmkfs\b', r'\bfdisk\b', r'\bdd\s+if=',
    r'\breboot\b', r'\bshutdown\b', r'\bpoweroff\b', r'\bhalt\b',
    r'\bsystemctl\s+(stop|disable)\b', r'\bservice\s+\S+\s+stop\b',
    r'\bkill\b', r'\bkillall\b', r'\bpkill\b',
    r'\bcurl\b.+\|\s*(bash|sh|zsh)\b', r'\bwget\b.+\|\s*(bash|sh|zsh)\b',
    r'\bfind\b.+-delete\b', r'>\s*/(?:dev|etc|boot|usr|var)/', r'\bchmod\b', r'\bchown\b',
]]
DANGEROUS_PATHS = ["/etc/", "/boot/", "/usr/", "/var/", "/sys/", "/proc/", "/root/", "/lib/", "/lib64/", "/bin/", "/sbin/"]
DANGEROUS_HOME_PATHS = [
    ".ssh/", ".bashrc", ".bash_profile", ".profile", ".zshrc", ".gnupg/",
    ".codex/auth.json", ".claude/.credentials.json", ".aws/credentials",
]
SENSITIVITY_LEVELS = ("low", "medium", "high")
_READ_ONLY_COMMANDS = {
    "df", "du", "free", "id", "ls", "pgrep", "ps", "pwd", "stat", "uname",
    "uptime", "wc", "which", "whoami",
}
_READ_ONLY_SYSTEMCTL_COMMANDS = {
    "is-active", "is-enabled", "list-unit-files", "list-units", "show", "status",
}


def _trusted_executable(command):
    resolved = shutil.which(command)
    if not resolved:
        return False
    real = os.path.realpath(resolved)
    if IS_WINDOWS:
        system32 = os.path.realpath(os.path.join(os.environ.get("WINDIR", "C:\\Windows"), "System32"))
        return os.path.dirname(real).lower() == system32.lower()
    return os.path.dirname(real) in ("/bin", "/usr/bin", "/sbin", "/usr/sbin")


def _host_read_only_command(tool_args):
    if _as_bool(tool_args.get("shell"), False):
        return False
    try:
        tokens = shlex.split(str(tool_args.get("command", "")), posix=not IS_WINDOWS)
    except ValueError:
        return False
    if not tokens or not _trusted_executable(tokens[0]):
        return False
    command = os.path.basename(tokens[0]).lower()
    if command.endswith(".exe"):
        command = command[:-4]
    if command in _READ_ONLY_COMMANDS:
        return True
    if command == "date":
        return len(tokens) == 1 or all(arg.startswith("+") for arg in tokens[1:])
    if command == "systemctl":
        return len(tokens) > 1 and tokens[1] in _READ_ONLY_SYSTEMCTL_COMMANDS
    return False


def _tool_metadata(tool_name, tool_args):
    model_sensitivity = str(tool_args.get("sensitivity", "")).strip().lower()
    host_notes = []
    overwrite_existing = False
    confirmed_stat = None
    if tool_name == "execute_command":
        host_sensitivity = "low" if _host_read_only_command(tool_args) else "high"
        changes_state = host_sensitivity != "low"
        if host_sensitivity == "high":
            host_notes.append("Host could not prove this command is read-only")
    elif tool_name in ("patch_file", "write_file"):
        host_sensitivity = "medium"
        changes_state = True
    else:
        host_sensitivity = "low"
        changes_state = False

    write_path = tool_args.get("path", "") if tool_name in ("patch_file", "write_file") else ""
    if write_path and os.path.exists(_safe_realpath(write_path)):
        try:
            confirmed_stat = os.stat(_safe_realpath(write_path), follow_symlinks=False)
        except OSError:
            confirmed_stat = None
        if tool_name == "write_file":
            overwrite_existing = True
            host_sensitivity = "high"
            host_notes.append("Full overwrite of an existing file")
    if _is_dangerous(tool_name, tool_args):
        host_sensitivity = "high"
    if model_sensitivity not in SENSITIVITY_LEVELS:
        model_sensitivity = "high" if tool_name in ("execute_command", "patch_file", "write_file") else "low"
    sensitivity = SENSITIVITY_LEVELS[max(
        SENSITIVITY_LEVELS.index(host_sensitivity),
        SENSITIVITY_LEVELS.index(model_sensitivity),
    )]

    return {
        "sensitivity": sensitivity,
        "changes_state": changes_state,
        "overwrite_existing": overwrite_existing,
        "confirmed_stat": confirmed_stat,
        "host_notes": host_notes,
    }


def _tool_metadata_brief(meta):
    if not meta:
        return ""
    parts = [meta["sensitivity"], "state-change" if meta["changes_state"] else "read-only"]
    if meta["overwrite_existing"]:
        parts.append("overwrite")
    return ", ".join(parts)


def _is_dangerous(tool_name, tool_args):
    """Local safeguard for clearly dangerous operations"""
    if tool_name == "execute_command":
        cmd = str(tool_args.get("command", ""))
        return any(r.search(cmd) for r in DANGEROUS_REGEXES)
    if tool_name in ("patch_file", "write_file"):
        # Normalize path to prevent ../ bypass
        path = _safe_realpath(tool_args.get("path", ""))
        if any(path.startswith(p) for p in DANGEROUS_PATHS):
            return True
        home = os.path.expanduser("~")
        rel = os.path.relpath(path, home)
        return not rel.startswith("..") and any(rel.startswith(p) for p in DANGEROUS_HOME_PATHS)
    return False


def confirm_action(tool_name, tool_args, auto_yes, confirm_default="n", force_yes=False, meta=None):
    forced = _is_dangerous(tool_name, tool_args)
    if meta is None:
        meta = _tool_metadata(tool_name, tool_args)
    sensitivity = meta["sensitivity"]
    # --force skips all confirmations except locally forced dangerous patterns
    if force_yes and not forced:
        return True
    if sensitivity == "low" and not forced:
        return True
    if auto_yes and sensitivity == "medium" and not forced:
        return True

    desc = _format_tool_args(tool_name, tool_args, meta)

    default_yes = confirm_default.lower() in ("y", "yes")
    hint = "[Y/n]" if default_yes else "[y/N]"
    print(f"\n\033[33m⚠ Confirmation required: {desc}\033[0m")
    print(f"  Sensitivity: {meta['sensitivity']}")
    print(f"  State change: {'yes' if meta['changes_state'] else 'no'}")
    for note in meta["host_notes"]:
        print(f"  Note: {note}")
    if tool_name == "patch_file":
        preview = _patch_preview(tool_args.get("path", ""), tool_args.get("edits", []))
        if "error" in preview:
            print(f"  Patch preview: unavailable ({preview['error']})")
        elif preview.get("preview"):
            print("  Patch preview:")
            print(_indent_block(preview["preview"]))
    if forced:
        print("  Local safeguard: forced confirmation for this action pattern")
    try:
        answer = input(f"Confirm? {hint} ").strip().lower()
    except EOFError:
        print("\033[33m  Confirmation unavailable on non-interactive input; skipped\033[0m")
        return False
    if not answer:
        return default_yes
    return answer in ("y", "yes")


