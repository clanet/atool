def _load_oauth_token(provider):
    """Load OAuth token from CLI tool credential files"""
    try:
        if provider == "claude":
            path = os.path.expanduser("~/.claude/.credentials.json")
        elif provider == "codex":
            path = os.path.expanduser("~/.codex/auth.json")
        else:
            return None
        if not os.path.exists(path):
            return None
        unsafe = _private_file_error(path)
        if unsafe:
            print(f"\033[31mWarning: {path} {unsafe}, ignored\033[0m")
            return None
        with open(path) as f:
            data = json.load(f)
        if provider == "claude":
            oauth = data.get("claudeAiOauth", {})
            expires_at = oauth.get("expiresAt")
            if expires_at and float(expires_at) <= time.time() * 1000:
                print("\033[31mWarning: Claude OAuth token is expired; refresh it with Claude CLI\033[0m")
                return None
            return oauth.get("accessToken")
        return data.get("OPENAI_API_KEY")
    except (OSError, ValueError, TypeError, json.JSONDecodeError):
        return None


