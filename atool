def _config_section(cp, section, keys):
    if not cp.has_section(section):
        return {}
    return {key: cp.get(section, key) for key in keys if cp.has_option(section, key)}

def load_config(args):
    """Merge config file, env vars, CLI args. Priority: CLI > env > config file > defaults"""
    provider = "openai"
    default_config = {}
    provider_profiles = {}

    conf_path = CONF_PATH
    if os.path.lexists(conf_path):
        unsafe = _private_file_error(conf_path)
        if unsafe:
            print(f"\033[31mWarning: config file {unsafe}, ignored\033[0m")
        else:
            try:
                cp = configparser.RawConfigParser()
                cp.read(conf_path)
                default_config = _config_section(
                    cp, "default", ("provider",) + _PROVIDER_CONFIG_KEYS + _GENERAL_CONFIG_KEYS
                )
                provider_profiles = {
                    name: _config_section(cp, name, _PROVIDER_CONFIG_KEYS)
                    for name in PROVIDER_DEFAULTS
                }
            except (OSError, configparser.Error) as e:
                print(f"\033[31mWarning: invalid config file ignored: {e}\033[0m")
                default_config = {}
                provider_profiles = {}

    configured_provider = default_config.get("provider", "openai")
    provider = configured_provider
    if os.environ.get("ATOOL_PROVIDER"):
        provider = os.environ["ATOOL_PROVIDER"]
    if getattr(args, "provider", None):
        provider = args.provider

    if provider not in PROVIDER_DEFAULTS:
        print(f"\033[31mError: unsupported provider: {provider}, available: openai, claude, codex\033[0m")
        sys.exit(1)

    # Start from provider defaults
    defaults = PROVIDER_DEFAULTS[provider]
    config = {"provider": provider, "api_url": defaults["api_url"], "api_key": "", "model": defaults["model"],
              "proxy": "", "auth_type": "key", "confirm_default": "n"}

    for key in _GENERAL_CONFIG_KEYS:
        if key in default_config:
            config[key] = default_config[key]
    # Backward compatibility: provider fields in [default] belong only to its provider.
    if provider == configured_provider:
        for key in _PROVIDER_CONFIG_KEYS:
            if key in default_config:
                config[key] = default_config[key]
    for key, value in provider_profiles.get(provider, {}).items():
        config[key] = value
    # Compat: old config auth_type=api_key
    if config["auth_type"] not in ("key", "oauth"):
        config["auth_type"] = "key"

    # Env vars (different var names per provider)
    if provider == "claude":
        env_map = [("ANTHROPIC_API_URL", "api_url"), ("ANTHROPIC_API_KEY", "api_key"), ("ANTHROPIC_MODEL", "model")]
    else:
        env_map = [("OPENAI_API_BASE", "api_url"), ("OPENAI_API_KEY", "api_key"), ("OPENAI_MODEL", "model")]

    for env_name, key in env_map:
        val = os.environ.get(env_name)
        if val:
            config[key] = val

    # Proxy: env vars
    for env_name in ("ATOOL_PROXY", "HTTPS_PROXY", "HTTP_PROXY", "ALL_PROXY"):
        val = os.environ.get(env_name) or os.environ.get(env_name.lower())
        if val:
            config["proxy"] = val
            break

    # CLI args (highest priority)
    if getattr(args, "api_url", None):
        config["api_url"] = args.api_url
    if getattr(args, "api_key", None):
        config["api_key"] = args.api_key
    if getattr(args, "model", None):
        config["model"] = args.model
    if getattr(args, "proxy", None):
        config["proxy"] = args.proxy

    # OAuth: dynamically load token from CLI credential files
    if config["auth_type"] == "oauth" and not config["api_key"]:
        token = _load_oauth_token(config["provider"])
        if token:
            config["api_key"] = token

    return config


