def _context_for_storage(value):
    """Copy JSON-compatible state while replacing large image payloads."""
    if isinstance(value, list):
        return [_context_for_storage(item) for item in value]
    if isinstance(value, dict):
        if value.get("type") in ("image", "image_url"):
            return {"type": "text", "text": "[Image omitted from saved context]"}
        return {key: _context_for_storage(item) for key, item in value.items()}
    if isinstance(value, str) and value.startswith("[Image: data:"):
        return "[Image omitted from saved context]"
    return value


def _save_context(state, provider, ctx_path=CONTEXT_PATH):
    """Save a private, bounded, image-redacted conversation context."""
    try:
        payload = json.dumps(
            {"provider": provider, "state": _context_for_storage(state)},
            ensure_ascii=False,
        )
        if len(payload.encode("utf-8")) > MAX_CONTEXT_FILE_SIZE:
            print("\033[33mWarning: context is too large to save safely\033[0m")
            return False
        _atomic_write_private(ctx_path, payload)
        return True
    except Exception as e:
        print(f"\033[33mWarning: could not save context: {e}\033[0m")
        return False


def _load_context(provider, ctx_path=CONTEXT_PATH):
    """Load previous context, return None if provider mismatch or invalid structure"""
    try:
        if not os.path.lexists(ctx_path):
            return None
        unsafe = _private_file_error(ctx_path)
        if unsafe:
            print(f"\033[33mContext file {unsafe}, starting new conversation\033[0m")
            return None
        with open(ctx_path) as f:
            if os.fstat(f.fileno()).st_size > MAX_CONTEXT_FILE_SIZE:
                print("\033[33mContext file too large, starting new conversation\033[0m")
                return None
            data = json.load(f)
        if data.get("provider") != provider:
            return None
        state = data["state"]
        # Basic structure validation
        if provider == "claude":
            if not isinstance(state, dict) or not isinstance(state.get("messages"), list):
                return None
        else:
            if not isinstance(state, list) or len(state) < 2:
                return None
            # Validate message format: first message must be system
            if not isinstance(state[0], dict) or state[0].get("role") != "system":
                return None
        return state
    except (OSError, KeyError, TypeError, json.JSONDecodeError):
        return None


def _acquire_context_lock(ctx_path):
    """Acquire a non-blocking advisory lock for one conversation file."""
    _ensure_private_dir()
    lock_path = ctx_path + ".lock"
    flags = os.O_CREAT | os.O_RDWR | getattr(os, "O_NOFOLLOW", 0)
    fd = os.open(lock_path, flags, 0o600)
    try:
        st = os.fstat(fd)
        if not stat.S_ISREG(st.st_mode) or (not IS_WINDOWS and st.st_uid != os.getuid()):
            raise OSError("Unsafe context lock file")
        _secure_chmod(lock_path, 0o600)
        if IS_WINDOWS:
            import msvcrt
            if st.st_size == 0:
                os.write(fd, b"0")
            os.lseek(fd, 0, os.SEEK_SET)
            msvcrt.locking(fd, msvcrt.LK_NBLCK, 1)
        else:
            import fcntl
            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        return fd
    except Exception:
        os.close(fd)
        raise


def _release_context_lock(fd):
    try:
        try:
            if IS_WINDOWS:
                import msvcrt
                os.lseek(fd, 0, os.SEEK_SET)
                msvcrt.locking(fd, msvcrt.LK_UNLCK, 1)
            else:
                import fcntl
                fcntl.flock(fd, fcntl.LOCK_UN)
        except OSError:
            pass
    finally:
        os.close(fd)


