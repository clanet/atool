    if legacy_provider in PROVIDER_DEFAULTS:
        if not cp.has_section(legacy_provider):
            cp.add_section(legacy_provider)
        for option in _PROVIDER_CONFIG_KEYS:
            if cp.has_option("default", option) and not cp.has_option(legacy_provider, option):
                cp.set(legacy_provider, option, cp.get("default", option))
    for option in _PROVIDER_CONFIG_KEYS:
        cp.remove_option("default", option)
    cp.set("default", "provider", provider)
    if not cp.has_section(provider):
        cp.add_section(provider)
    cp.set(provider, "auth_type", auth_type)
    cp.set(provider, "api_url", url)
    cp.set(provider, "model", model)
    if auth_type != "oauth":
        cp.set(provider, "api_key", key)
    else:
        cp.remove_option(provider, "api_key")
    if proxy:
        cp.set("default", "proxy", proxy)
    else:
        cp.remove_option("default", "proxy")

    output = io.StringIO()
    cp.write(output)
    _atomic_write_private(conf_path, output.getvalue())

    print(f"\n\033[32mConfig saved to {conf_path}\033[0m\n")


